#
# Translation routines for the instructions of the xjitdomain extension
#
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Domain-typed loads and stores: the base LOAD/STORE formats, in custom-0
# and custom-1. funct3 = 111 is reserved in both.

# Fields:
%rs2       20:5
%rs1       15:5
%rd        7:5
%imm_i     20:s12
%imm_s     25:s7 7:5

# Argument sets
&i         imm rs1 rd                               !extern
&s         imm rs1 rs2                              !extern

# Formats
@i         ............    ..... ... ..... .......  &i imm=%imm_i %rs1 %rd
@s         .......  ..... ..... ... ..... .......   &s imm=%imm_s %rs2 %rs1

dlb        ............    ..... 000 ..... 0001011  @i
dlh        ............    ..... 001 ..... 0001011  @i
dlw        ............    ..... 010 ..... 0001011  @i
dld        ............    ..... 011 ..... 0001011  @i
dlbu       ............    ..... 100 ..... 0001011  @i
dlhu       ............    ..... 101 ..... 0001011  @i
dlwu       ............    ..... 110 ..... 0001011  @i
dsb        .......  ..... ..... 000 ..... 0101011   @s
dsh        .......  ..... ..... 001 ..... 0101011   @s
dsw        .......  ..... ..... 010 ..... 0101011   @s
dsd        .......  ..... ..... 011 ..... 0101011   @s
